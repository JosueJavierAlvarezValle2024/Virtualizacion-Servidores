# Lo que se ejecuta en Linux va siempre con fin de linea LF
*.sh        text eol=lf
*.conf      text eol=lf
*.cnf       text eol=lf
*.xml       text eol=lf
*.sql       text eol=lf
*.php       text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
Vagrantfile text eol=lf
# Lo que se ejecuta en Windows (PowerShell) va con CRLF
*.ps1       text eol=crlf
*.docx      binary
*.pdf       binary
*.png       binary
